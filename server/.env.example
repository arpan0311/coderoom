# Port for the API + Socket.io server
PORT=5000

# MongoDB connection (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/interview_platform

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Frontend URL(s) allowed to call this API (comma separated)
CLIENT_URL=http://localhost:5173

# How candidate code is run:
#   process = child process on this machine, uses the compilers installed here
#             (good for local dev, NOT fully safe)
#   docker  = fresh locked-down container per run from the coderoom-runner image
#             (has Python, Java, C++ and Node). Use this in production.
SANDBOX_DRIVER=process
DOCKER_IMAGE=coderoom-runner
RUN_TIMEOUT_MS=2000
COMPILE_TIMEOUT_MS=15000
RUN_MEMORY_MB=512

# Job queue. Leave REDIS_URL empty to use the built-in in-memory queue.
REDIS_URL=
RUN_CONCURRENCY=2
# true = the API server also runs the worker. false = run "npm run worker" separately.
INLINE_WORKER=true
